---
// Custom 404 in the HUD visual style. Firebase Hosting serves dist/404.html
// automatically (with a 404 status) for any unknown path.
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found — Willem Smith" description="The requested page does not exist on this site." noindex>
  <section class="min-h-screen flex items-center justify-center px-8 md:px-16 pt-32 pb-16">
    <div class="max-w-2xl w-full text-center">
      <div aria-hidden="true" class="font-label-code text-stark-red text-sm uppercase tracking-widest mb-6 flex items-center justify-center gap-3">
        <span class="w-1.5 h-1.5 rounded-full bg-stark-red animate-pulse"></span>ERR_404 // SIGNAL_LOST
      </div>
      <h1 class="font-display-lg text-5xl md:text-7xl text-white uppercase tracking-tighter leading-[1.1] mb-6">
        Page not found
      </h1>
      <p class="text-on-surface-variant text-base md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">
        The address you followed does not exist on this site. It may have moved, or the link may be incomplete.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 border border-slate-cyan/40 text-slate-cyan rounded bg-slate-cyan/5 hover:bg-slate-cyan/10 transition-colors font-label-code text-xs uppercase tracking-widest"
      >
        Return to base ↗
      </a>
    </div>
  </section>
</BaseLayout>
